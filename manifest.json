{
  "manifestVersion": 2,
  "id": "eleckoi-tavern",
  "name": "夜航船 · Night Ferry Tavern",
  "version": "0.2.0-m8",
  "description": "夜航船 · Night Ferry Tavern · Hana v2 App — 角色卡、对话、LLM、变量、设定库、提示词预设、工具、迁移。",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "0.982.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/ui.open-external",
    "app/resources.read",
    "app/models.infer",
    "app/models.read",
    "app/provider.credentials.read",
    "app/media.generate",
    "app/runtime.network",
    "app/services.call",
    "app/environments.manage"
  ],
  "network": {
    "allowedHosts": [
      "api.siliconflow.cn",
      "zh.moegirl.org.cn",
      "export.arxiv.org",
      "api.openai.com",
      "eastasia.tts.speech.microsoft.com",
      "southeastasia.tts.speech.microsoft.com",
      "eastus.tts.speech.microsoft.com",
      "westus.tts.speech.microsoft.com",
      "westeurope.tts.speech.microsoft.com",
      "japaneast.tts.speech.microsoft.com",
      "koreacentral.tts.speech.microsoft.com",
      "centralindia.tts.speech.microsoft.com"
    ],
    "methods": ["GET", "POST", "PUT"],
    "allowLocalhost": true,
    "defaultTimeoutMs": 60000,
    "maxResponseBytes": 8388608
  },
  "contributes": {
    "cards": [
      {
        "id": "characters",
        "title": "夜航船",
        "description": "角色卡管理、对话、LLM 角色扮演",
        "route": "/characters.html",
        "cardForm": "flush",
        "realization": "page",
        "fpFullPanel": true,
        "siteNavEntry": true,
        "functionPanel": {
          "id": "rail",
          "label": "角色与对话",
          "route": "/rail.html"
        },
        "closable": false,
        "face": {
          "image": "assets/icon-photo.png"
        }
      }
    ],
    "ui": {
      "inputStatus": [
        {
          "id": "tavern-status",
          "title": "夜航船",
          "icon": "check"
        }
      ]
    }
  }
}